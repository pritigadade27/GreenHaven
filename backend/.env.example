# Copy to backend/.env and fill in. The real file is git-ignored.
MYSQL_USER=priti
MYSQL_PASSWORD=

# Sign the JWTs. Use a long random string; changing it signs everybody out.
GREENHAVEN_JWT_SECRET=

# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. Signs the webhook payload.
RAZORPAY_WEBHOOK_SECRET=
# live | simulated
RAZORPAY_MODE=simulated

# Seeded once at first startup; changing it later does NOT update the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
